<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/netflix_background"
    tools:context=".ui.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Featured Banner -->
            <FrameLayout
                android:id="@+id/featured_container"
                android:layout_width="match_parent"
                android:layout_height="420dp">

                <ImageView
                    android:id="@+id/iv_featured"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_featured" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_featured_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_featured"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="🏆 #1 IN ANIME TODAY"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_featured_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:shadowColor="#000"
                        android:shadowRadius="6"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tv_featured_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#46D369"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_featured_play"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:backgroundTint="@color/white"
                            android:text="▶  Play"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            style="@style/Widget.AppCompat.Button" />

                        <Button
                            android:id="@+id/btn_featured_info"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:backgroundTint="#66FFFFFF"
                            android:text="ℹ  Info"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:layout_marginStart="8dp"
                            style="@style/Widget.AppCompat.Button" />

                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- Sort/Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:checkable="true"
                        android:checked="true"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Top Score"
                        android:checkable="true"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔤 A-Z"
                        android:checkable="true"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_episodes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📺 Episodes"
                        android:checkable="true"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_marginEnd="6dp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Section Title -->
            <TextView
                android:id="@+id/tv_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="Top Anime"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Anime Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_anime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                tools:listitem="@layout/item_anime" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
