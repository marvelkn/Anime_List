<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — NoActionBar so we can use our custom Toolbar -->
    <style name="Base.Theme.Anime_List" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/netflix_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/netflix_background</item>
        <item name="colorSurface">@color/netflix_background</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <!-- Chip colors -->
        <item name="chipBackgroundColor">#2A2A2A</item>
        <item name="chipStrokeColor">#444444</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <style name="Theme.Anime_List" parent="Base.Theme.Anime_List" />
</resources>